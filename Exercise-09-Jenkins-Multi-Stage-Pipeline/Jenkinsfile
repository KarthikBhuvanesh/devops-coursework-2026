
pipeline {
    agent {
        label 'exercise6-agent'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_DIR = 'Exercise-09-Jenkins-Multi-Stage-Pipeline'
        DEPLOY_DIR = "${WORKSPACE}/Exercise-09-Jenkins-Multi-Stage-Pipeline/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Running unit tests...'
                    sh '''
                        .venv/bin/python -m unittest discover -s .
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Deploying application to mock deployment directory...'
                    sh '''
                        mkdir -p "$DEPLOY_DIR"
                        cp app.py "$DEPLOY_DIR/"
                        cp requirements.txt "$DEPLOY_DIR/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the deployed Flask application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"

                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        old_pid=$(cat "$DEPLOY_DIR/app.pid")
                        kill "$old_pid" 2>/dev/null || true
                        rm -f "$DEPLOY_DIR/app.pid"
                    fi

                    nohup "$WORKSPACE/$APP_DIR/.venv/bin/python" \
                        "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &
                    echo $! > "$DEPLOY_DIR/app.pid"

                    for i in $(seq 1 20); do
                        if "$WORKSPACE/$APP_DIR/.venv/bin/python" -c \
                            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/', timeout=2)" \
                            2>/dev/null; then
                            echo "Application is responding."
                            exit 0
                        fi
                        sleep 1
                    done

                    cat "$DEPLOY_DIR/app.log"
                    echo "Application did not become ready."
                    exit 1
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the deployed application over HTTP...'
                sh '''
                    "$WORKSPACE/$APP_DIR/.venv/bin/python" -c "
import urllib.request
url = 'http://127.0.0.1:5000/'
with urllib.request.urlopen(url, timeout=5) as response:
    body = response.read().decode('utf-8')
    print(body)
    assert response.status == 200
    assert body == 'Hello, Jenkins Multi-Stage Pipeline!'
print('Deployed application test passed.')
"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs for details.'
        }
        always {
            sh '''
                if [ -f "$DEPLOY_DIR/app.pid" ]; then
                    pid=$(cat "$DEPLOY_DIR/app.pid")
                    kill "$pid" 2>/dev/null || true
                    rm -f "$DEPLOY_DIR/app.pid"
                fi
            '''
        }
    }
}
